GROQ_API_KEY=your_groq_api_key_here
GROQ_TIMEOUT_SEC=30.0

# Optional: opt-in to multilingual embeddings for Hindi transcripts (requires ~445MB RAM)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2


# Chat memory limits (optional; MAX_HISTORY_MESSAGES is rounded down to the nearest even number)
# MAX_HISTORY_MESSAGES=20   # max messages kept per video session
# MAX_CHAT_SESSIONS=100    # max concurrent video sessions in memory (LRU-evicted)
